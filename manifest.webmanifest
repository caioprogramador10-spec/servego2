{
  "name": "ServeGo — o profissional que você precisa",
  "short_name": "ServeGo",
  "description": "Peça e o profissional verificado mais próximo vai até você. Preço fechado, pagamento pelo app.",
  "lang": "pt-BR",
  "dir": "ltr",
  "id": "/app.html",
  "start_url": "app.html#/inicio",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#070706",
  "theme_color": "#070706",
  "categories": ["lifestyle", "business", "utilities"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/logo-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Pedir um serviço", "short_name": "Pedir", "url": "app.html#/solicitar",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mensagens", "url": "app.html#/mensagens",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
